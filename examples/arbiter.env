# Example environment for the CLI and the TUI. Copy to arbiter.env and edit.
# The CLI and the TUI read this file when a variable is missing; exported
# variables always win. The service (arbiter-api) expects them from its process
# manager. No secrets belong in this file.

ARBITER_CONFIG=/path/to/ArbiterRAG/arbiter.yaml
ARBITER_DB=/home/user/.cache/arbiterrag/db
ARBITER_BASE_URL=http://127.0.0.1:8080
ARBITER_EMBED_MODEL=bge-m3
ARBITER_CORPUS=/home/user/Documents

# Only for arbiter-api.
ARBITER_BIND=127.0.0.1
ARBITER_PORT=8091
